# Cesium ion access tokens for the optional photorealistic 3D city layer.
# Get them at https://ion.cesium.com/tokens with the "assets:read" scope.
# Several tokens may be listed, separated by commas; each retry advances to the next one.
# Note that ion issues every token on an account the same shared Google key, so extra
# tokens buy resilience against a revoked token, not extra imagery quota.
# Without any token the 3D CITY toggle is hidden and the graphite vector map is the only
# basemap.
VITE_CESIUM_ION_TOKEN=token-one,token-two
